{
  "name": "mesh-harness",
  "version": "0.1.21",
  "description": "mesh-harness: one place to see and steer all your Claude Code sessions",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arielik/mesh-harness.git"
  },
  "homepage": "https://github.com/arielik/mesh-harness#readme",
  "bugs": {
    "url": "https://github.com/arielik/mesh-harness/issues"
  },
  "keywords": [
    "claude-code",
    "agents",
    "hooks",
    "mcp",
    "tmux",
    "coordination"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "bin": {
    "mesh": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "schemas",
    "scripts/install.sh",
    "LICENSE.md",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && vite build --config web/vite.config.ts --logLevel warn",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test && pnpm build",
    "spike": "node spikes/run.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test:web": "playwright test",
    "schemas": "node scripts/schemas.ts",
    "test:claude": "node spikes/run.ts contract"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.16",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
