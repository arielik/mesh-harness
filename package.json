{
  "name": "@ours/mesh",
  "version": "0.0.0",
  "private": true,
  "description": "mesh-harness: one place to see and steer all your Claude Code sessions",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "bin": {
    "mesh": "./dist/main.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test && pnpm build",
    "spike": "node spikes/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "zod": "^4.6.7"
  }
}
